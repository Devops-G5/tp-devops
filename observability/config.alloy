prometheus.scrape "devops_api" {
  targets = [
    {"__address__" = "api:8080"},
  ]

  job_name        = "devops-api"
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"

  forward_to = [
    prometheus.remote_write.metrics_hosted_prometheus.receiver,
  ]
}

prometheus.remote_write "metrics_hosted_prometheus" {
  endpoint {
    name = "hosted-prometheus"
    url  = "https://prometheus-prod-40-prod-sa-east-1.grafana.net/api/prom/push"

    basic_auth {
      username = "3652179"
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}