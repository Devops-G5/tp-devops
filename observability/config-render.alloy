prometheus.scrape "devops_api" {
  targets = [
    {"__address__" = "https://tp-devops-g5-1-1-0.onrender.com"},
  ]

  scheme         = "https"
  job_name       = "devops-api"
  metrics_path   = "/actuator/prometheus"
  scrape_interval = "30s"

  forward_to = [
    prometheus.remote_write.metrics_hosted_prometheus.receiver,
  ]
}